<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:padding="22dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="LIVE FIELD // SCANNER"
            android:textColor="#FF4FD8"
            android:textSize="23sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/strongestText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="SIGNAL LOCK  --   strongest observation: waiting"
            android:textColor="#F0B35A"
            android:textSize="11sp"
            android:fontFamily="monospace" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/countText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="#10142B"
                android:padding="14dp"
                android:text="0\nWi-Fi"
                android:textColor="#8FF7FF"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/bleCountText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:background="#10142B"
                android:padding="14dp"
                android:text="0\nBLE"
                android:textColor="#FF4FD8"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/gpsCountText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:background="#10142B"
                android:padding="14dp"
                android:text="0&#10;GPS SAT"
                android:textColor="#F0B35A"
                android:textSize="18sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="AIRSPACE / CHANNEL ACTIVITY"
            android:textColor="#F0B35A"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/spectrumText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:background="#10142B"
            android:fontFamily="monospace"
            android:lineSpacingExtra="3dp"
            android:padding="12dp"
            android:text="No channel activity yet"
            android:textColor="#8FF7FF"
            android:textSize="12sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="LIVE OBSERVATIONS"
            android:textColor="#F0B35A"
            android:textSize="11sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/allButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minHeight="44dp"
                android:text="ALL"
                android:textColor="#050611"
                android:backgroundTint="#F0B35A" />

            <Button
                android:id="@+id/wifiButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:minHeight="44dp"
                android:text="WI-FI"
                android:textColor="#8FF7FF"
                android:backgroundTint="#17112D" />

            <Button
                android:id="@+id/bleButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:minHeight="44dp"
                android:text="BLE"
                android:textColor="#FF4FD8"
                android:backgroundTint="#17112D" />
        </LinearLayout>

        <TextView
            android:id="@+id/viewText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="VIEW  ALL   /   0 live signals"
            android:textColor="#8FF7FF"
            android:textSize="11sp"
            android:fontFamily="monospace" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="THREAT RADAR / PASSIVE SIGNAL FIELD"
            android:textColor="#FF4FD8"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="CODE STREAM / LIVE VISUALIZER"
            android:textColor="#8FF7FF"
            android:textSize="11sp"
            android:textStyle="bold" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="88dp"
            android:layout_marginTop="5dp"
            android:background="@drawable/code_stream_background"
            android:padding="2dp">

            <com.wigglefish.android.MatrixRainView
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <TextView
                android:id="@+id/decodeText"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:padding="14dp"
                android:text=""
                android:textColor="#FF4FD8"
                android:textSize="13sp"
                android:lineSpacingExtra="4dp"
                android:fontFamily="monospace" />
        </FrameLayout>

        <com.wigglefish.android.SignalRadarView
            android:id="@+id/radarView"
            android:layout_width="match_parent"
            android:layout_height="190dp"
            android:layout_marginTop="6dp" />

        <TextView
            android:id="@+id/categoryText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="#10142B"
            android:fontFamily="monospace"
            android:padding="10dp"
            android:text="CAMERAS  00     FLIPPER-LIKE  00     AIRTAG-LIKE  00&#10;OTHER WIFI  00     OTHER BLE  00"
            android:textColor="#8FF7FF"
            android:textSize="11sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:layout_marginBottom="12dp"
            android:background="#0A0D20"
            android:padding="14dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/resultsText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:lineSpacingExtra="7dp"
                android:text="Waiting for passive observations..."
                android:textColor="#D6D9FF"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
