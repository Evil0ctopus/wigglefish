<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:padding="22dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="FLASH // FIRMWARE"
            android:textColor="#FF4FD8"
            android:textSize="23sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="COMING SOON — honest empty state"
            android:textColor="#F0B35A"
            android:textSize="13sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="#10142B"
            android:padding="16dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:lineSpacingExtra="6dp"
                android:text="In-app flash is not shipped yet.\n\nBig-brother loop we are building toward:\n  1. DETECT  — Connect finds your USB board\n  2. FLASH   — install a compatible passive firmware\n  3. DRIVE   — Live Field runs the survey session\n\nFor now, flash from a desktop browser with the repo ESP Web Tools / firmware release assets. This page will list compatible firmwares once the in-app path exists.\n\nNo fake flash UI. No pretend progress bars."
                android:textColor="#D6D9FF"
                android:textSize="13sp" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="Passive safety scope unchanged — survey only, no offensive features."
            android:textColor="#5D958D"
            android:textSize="11sp"
            android:fontFamily="monospace" />
    </LinearLayout>
</ScrollView>
