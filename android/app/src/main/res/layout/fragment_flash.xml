<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:padding="22dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="FLASH // FIRMWARE"
            android:textColor="#FF4FD8"
            android:textSize="23sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="PR2 — IDENTIFY + IN-APP FLASH WRITE"
            android:textColor="#F0B35A"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/flashStatusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:fontFamily="monospace"
            android:text="Plug board via USB-C OTG (data cable). Connect → Identify → select image → Flash."
            android:textColor="#8FF7FF"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/flashDeviceText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="monospace"
            android:text="USB DEVICE  NO USB DEVICE"
            android:textColor="#D6D9FF"
            android:textSize="11sp" />

        <Button
            android:id="@+id/flashConnectButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:minHeight="52dp"
            android:text="CONNECT / USE USB DEVICE"
            android:textColor="#050611"
            android:backgroundTint="#8FF7FF" />

        <Button
            android:id="@+id/identifyChipButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:minHeight="52dp"
            android:text="IDENTIFY CHIP"
            android:textColor="#050611"
            android:backgroundTint="#FF4FD8" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="#10142B"
            android:padding="16dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="IDENTIFY RESULTS"
                android:textColor="#F0B35A"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/identifyResultText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:fontFamily="monospace"
                android:lineSpacingExtra="5dp"
                android:text="Waiting for Identify…\n\nChip family comes from ROM probe (SYNC + GET_SECURITY_INFO / magic).\nUSB VID/PID alone cannot tell WT013261-S5 vs WT32C3-S5 vs WT018684-S5."
                android:textColor="#D6D9FF"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="FIRMWARE IMAGE"
            android:textColor="#F0B35A"
            android:textSize="11sp"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/firmwareSpinner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:minHeight="48dp"
            android:background="#10142B"
            android:padding="8dp" />

        <TextView
            android:id="@+id/firmwareNotesText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="monospace"
            android:text="Identify a chip to list compatible images."
            android:textColor="#D6D9FF"
            android:textSize="11sp" />

        <Button
            android:id="@+id/flashWriteButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:minHeight="52dp"
            android:enabled="false"
            android:text="FLASH SELECTED IMAGE"
            android:textColor="#050611"
            android:backgroundTint="#7CFFB2" />

        <ProgressBar
            android:id="@+id/flashProgressBar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:max="100"
            android:progress="0"
            android:progressTint="#8FF7FF" />

        <TextView
            android:id="@+id/flashProgressText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:fontFamily="monospace"
            android:text="Idle"
            android:textColor="#8FF7FF"
            android:textSize="12sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="#10142B"
            android:padding="16dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="FLASH LOG"
                android:textColor="#F0B35A"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/flashLogText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:fontFamily="monospace"
                android:lineSpacingExtra="4dp"
                android:text="Flow: IDENTIFY → select compatible image → FLASH → reset to run → Live Field / Connect.\nKotlin ROM protocol (SYNC / SPI_ATTACH / FLASH_BEGIN+DATA / MD5). Not Python esptool."
                android:textColor="#D6D9FF"
                android:textSize="11sp" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="#10142B"
            android:padding="12dp"
            android:fontFamily="monospace"
            android:lineSpacingExtra="4dp"
            android:text="OTG: use a data-capable USB-C OTG adapter; charge-only cables fail silently.\nFlash of ~1.3 MB at 115200–460800 can take 1–3 minutes — keep the cable still.\nC3 / classic ESP32 images are stubbed until packaged builds exist."
            android:textColor="#D6D9FF"
            android:textSize="11sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="Passive safety scope unchanged — identify/flash tooling only, no offensive RF features."
            android:textColor="#5D958D"
            android:textSize="11sp"
            android:fontFamily="monospace" />
    </LinearLayout>
</ScrollView>
