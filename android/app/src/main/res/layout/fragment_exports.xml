<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:padding="22dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="EXPORTS // WARDRIVE PACK"
            android:textColor="#FF4FD8"
            android:textSize="23sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/sessionText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="SESSION  00:00  Wi-Fi 0  BLE 0  GPS pts 0  hits 0  quality idle"
            android:textColor="#5D958D"
            android:textSize="12sp"
            android:fontFamily="monospace" />

        <TextView
            android:id="@+id/coverageText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="COVERAGE  waiting for GPS + observations"
            android:textColor="#F0B35A"
            android:textSize="11sp"
            android:fontFamily="monospace" />

        <TextView
            android:id="@+id/sourceText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="ESP32_SERIAL 0   PHONE 0   LEGACY_SERIAL 0"
            android:textColor="#FF4FD8"
            android:textSize="11sp"
            android:fontFamily="monospace" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="EXPORT FORMATS"
            android:textColor="#F0B35A"
            android:textSize="11sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/exportButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:minHeight="52dp"
            android:text="EXPORT JSON"
            android:textColor="#050611"
            android:backgroundTint="#8FF7FF" />

        <Button
            android:id="@+id/csvButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:minHeight="52dp"
            android:text="EXPORT CSV"
            android:textColor="#050611"
            android:backgroundTint="#F0B35A" />

        <Button
            android:id="@+id/wardriveGoButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:minHeight="52dp"
            android:text="EXPORT WARDRIVE GO CSV"
            android:textColor="#050611"
            android:backgroundTint="#FF4FD8" />

        <Button
            android:id="@+id/wigleButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:minHeight="52dp"
            android:text="EXPORT WIGLE CSV"
            android:textColor="#050611"
            android:backgroundTint="#8FF7FF" />

        <Button
            android:id="@+id/geoJsonButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:minHeight="52dp"
            android:text="EXPORT GEOJSON"
            android:textColor="#050611"
            android:backgroundTint="#F0B35A" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="SESSION CONTROLS"
            android:textColor="#F0B35A"
            android:textSize="11sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/stopAllButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:minHeight="52dp"
            android:text="STOP ALL COLLECTION"
            android:textColor="#F4F7FF"
            android:backgroundTint="#5A1A2E" />

        <Button
            android:id="@+id/clearButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:minHeight="52dp"
            android:text="CLEAR SESSION"
            android:textColor="#F4F7FF"
            android:backgroundTint="#17112D" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="#10142B"
            android:padding="12dp"
            android:fontFamily="monospace"
            android:lineSpacingExtra="4dp"
            android:text="JSON = fused session pack (observations + GPS timeline).&#10;CSV = enriched generic rows.&#10;Wardrive Go CSV = MAC/SSID/AUTH/CHANNEL/RSSI/TYPE/NAME + GPS.&#10;WiGLE CSV = WigleWifi-1.6 compatible (WIFI + BLE).&#10;GeoJSON = FeatureCollection of APs/BLE with coordinates.&#10;Passive metadata-only — no handshakes / PCAP / attack tools."
            android:textColor="#D6D9FF"
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
