<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:top="6dp">
        <shape android:shape="rectangle">
            <corners android:radius="8dp" />
            <solid android:color="#05070A" />
        </shape>
    </item>
    <item android:bottom="6dp">
        <shape android:shape="rectangle">
            <corners android:radius="8dp" />
            <gradient
                android:startColor="#22232D"
                android:endColor="#17171F"
                android:angle="270" />
            <stroke android:width="1.5dp" android:color="#44DCCB" />
        </shape>
    </item>
    <!-- Top inner highlight gloss reflection -->
    <item android:bottom="16dp" android:top="2dp" android:left="8dp" android:right="8dp">
        <shape android:shape="rectangle">
            <corners android:radius="5dp" />
            <solid android:color="#0EFFFFFF" />
        </shape>
    </item>
</layer-list>

