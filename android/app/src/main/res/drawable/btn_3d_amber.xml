<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <layer-list>
            <item android:top="5dp">
                <shape android:shape="rectangle">
                    <corners android:radius="6dp" />
                    <solid android:color="#A87050" />
                    <stroke android:width="1dp" android:color="#DDB28B" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item android:top="5dp">
                <shape android:shape="rectangle">
                    <corners android:radius="6dp" />
                    <solid android:color="#563A31" />
                </shape>
            </item>
            <item android:bottom="5dp">
                <shape android:shape="rectangle">
                    <corners android:radius="6dp" />
                    <gradient
                        android:startColor="#DDB28B"
                        android:endColor="#9B674E"
                        android:angle="270" />
                    <stroke android:width="1dp" android:color="#E0B990" />
                </shape>
            </item>
            <!-- Top Gloss Sheen -->
            <item android:bottom="14dp" android:top="2dp" android:left="6dp" android:right="6dp">
                <shape android:shape="rectangle">
                    <corners android:radius="3dp" />
                    <solid android:color="#13FFFFFF" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>

