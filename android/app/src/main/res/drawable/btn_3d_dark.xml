<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <layer-list>
            <item android:top="5dp">
                <shape android:shape="rectangle">
                    <corners android:radius="6dp" />
                    <solid android:color="#303742" />
                    <stroke android:width="1dp" android:color="#69737F" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item android:top="5dp">
                <shape android:shape="rectangle">
                    <corners android:radius="6dp" />
                    <solid android:color="#080A0F" />
                </shape>
            </item>
            <item android:bottom="5dp">
                <shape android:shape="rectangle">
                    <corners android:radius="6dp" />
                    <gradient
                        android:startColor="#303640"
                        android:endColor="#1A1E26"
                        android:angle="270" />
                    <stroke android:width="1dp" android:color="#444D5A" />
                </shape>
            </item>
            <item android:bottom="14dp" android:top="2dp" android:left="6dp" android:right="6dp">
                <shape android:shape="rectangle">
                    <corners android:radius="3dp" />
                    <solid android:color="#0DFFFFFF" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>

