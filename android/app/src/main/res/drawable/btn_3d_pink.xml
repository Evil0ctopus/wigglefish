<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <layer-list>
            <item android:top="5dp">
                <shape android:shape="rectangle">
                    <corners android:radius="6dp" />
                    <solid android:color="#78408A" />
                    <stroke android:width="1dp" android:color="#D192DF" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item android:top="5dp">
                <shape android:shape="rectangle">
                    <corners android:radius="6dp" />
                    <solid android:color="#412444" />
                </shape>
            </item>
            <item android:bottom="5dp">
                <shape android:shape="rectangle">
                    <corners android:radius="6dp" />
                    <gradient
                        android:startColor="#D58ADF"
                        android:endColor="#79438D"
                        android:angle="270" />
                    <stroke android:width="1dp" android:color="#E1A8E8" />
                </shape>
            </item>
            <!-- Top Gloss Highlight -->
            <item android:bottom="14dp" android:top="2dp" android:left="6dp" android:right="6dp">
                <shape android:shape="rectangle">
                    <corners android:radius="3dp" />
                    <solid android:color="#13FFFFFF" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>

