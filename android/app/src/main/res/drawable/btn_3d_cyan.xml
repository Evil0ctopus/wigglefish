<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Pressed state: Button pushes down into its 3D bevel -->
    <item android:state_pressed="true">
        <layer-list>
            <item android:top="5dp">
                <shape android:shape="rectangle">
                    <corners android:radius="6dp" />
                    <solid android:color="#138F88" />
                    <stroke android:width="1dp" android:color="#40E8D0" />
                </shape>
            </item>
        </layer-list>
    </item>
    <!-- Normal state: Glossy chunky 3D toy button -->
    <item>
        <layer-list>
            <!-- 3D Base Shadow Block -->
            <item android:top="5dp">
                <shape android:shape="rectangle">
                    <corners android:radius="6dp" />
                    <solid android:color="#06443F" />
                </shape>
            </item>
            <!-- Main Button Face -->
            <item android:bottom="5dp">
                <shape android:shape="rectangle">
                    <corners android:radius="6dp" />
                    <gradient
                        android:startColor="#59E6D0"
                        android:endColor="#16A89D"
                        android:angle="270" />
                    <stroke android:width="1dp" android:color="#78F4E3" />
                </shape>
            </item>
            <!-- Top Gloss Sheen Bar -->
            <item android:bottom="14dp" android:top="2dp" android:left="6dp" android:right="6dp">
                <shape android:shape="rectangle">
                    <corners android:radius="3dp" />
                    <solid android:color="#13FFFFFF" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>

